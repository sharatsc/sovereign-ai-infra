          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/aigateways', variables('gatewayName'))]",
        "[extensionResourceId(resourceId('Microsoft.CognitiveServices/accounts', variables('modelAccountName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.CognitiveServices/accounts', variables('modelAccountName')), resourceId('Microsoft.ApiManagement/aigateways', variables('gatewayName')), variables('foundryUserRole')))]",
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('modelAccountName'))]"
