        "[resourceId('Microsoft.Insights/components', format('{0}-insights', variables('agentAccountName')))]"
      ]
    },
    {
      "condition": "[parameters('deployAgentResources')]",
      "type": "Microsoft.CognitiveServices/accounts/projects",
      "apiVersion": "2026-09-01",
      "name": "[format('{0}/{1}', variables('agentAccountName'), variables('projectName'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "displayName": "Sovereign AI provider models",
        "description": "Foundry project for hosted agents that call models through the AI Gateway."
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('agentAccountName'))]"
      ]
    },
    {
      "condition": "[parameters('deployAgentResources')]",
