        "/openai/v1/chat/completions",
        "/openai/v1/responses"
      ],
      "Anthropic": [
        "/anthropic/v1/messages"
      ]
    },
    "allAliases": "[concat(variables('directAliases'), parameters('aliases'))]",
    "apiFormatByFormat": {
      "OpenAI": "OpenAIChatCompletions",
      "Anthropic": "AnthropicMessages"
    },
    "foundryUserRole": "53ca6127-db72-4b80-b1b0-d745d6d5456d",
    "cognitiveServicesUserRole": "a97b65f3-24c7-4388-baec-2e87135dc908",
    "cognitiveServicesOpenAIUserRole": "5e0bd9bd-7b93-4f28-af87-19fc36ad61bd",
    "cognitiveServicesContributorRole": "25fbc0a9-bd7c-42a3-aa1a-3b75d497ee68",
    "storageBlobDataContributorRole": "ba92f5b4-2d11-453d-a403-e96b0029c9fe",
    "acrPullRole": "7f951dda-4ed3-4680-a7ca-43fe172d538d",
    "aiGatewayUserRole": "caad7a21-134e-43f4-a550-c5ffc17e051c"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
