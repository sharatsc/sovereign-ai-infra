        "credentials": {
          "key": "[reference(resourceId('Microsoft.Insights/components', format('{0}-insights', variables('agentAccountName'))), '2020-02-02').ConnectionString]"
        },
        "metadata": {
          "ApiType": "Azure",
          "ResourceId": "[resourceId('Microsoft.Insights/components', format('{0}-insights', variables('agentAccountName')))]"
        }
      },
      "dependsOn": [
