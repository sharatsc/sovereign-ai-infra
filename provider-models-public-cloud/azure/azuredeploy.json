{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "8420879510800826650"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "eastus2",
      "allowedValues": [
        "eastus2",
        "swedencentral"
      ],
      "metadata": {
        "description": "Region for Foundry and monitoring. Claude models need a region that offers them."
      }
    },
    "aiGatewayLocation": {
      "type": "string",
      "defaultValue": "eastus2",
      "allowedValues": [
        "eastus2",
        "swedencentral"
      ],
      "metadata": {
        "description": "Region for the AI Gateway (preview regions only)."
      }
    },
    "namePrefix": {
      "type": "string",
      "defaultValue": "sovai",
      "minLength": 3,
      "maxLength": 8,
      "metadata": {
        "description": "Short lowercase prefix for resource names."
      }
    },
    "principalId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional extra Entra object ID (user, group or service principal) to grant access. The account that runs the deployment always gets access."
      }
    },
    "principalType": {
      "type": "string",
      "defaultValue": "User",
      "allowedValues": [
        "User",
        "Group",
        "ServicePrincipal"
      ],
      "metadata": {
        "description": "Type of principalId."
      }
    },
    "organizationName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Organization name sent to Anthropic. Needed only if models includes an Anthropic (Claude) deployment."
      }
    },
    "industry": {
      "type": "string",
      "defaultValue": "Financial Services",
      "metadata": {
        "description": "Industry sent to Anthropic. Needed only for Anthropic (Claude) deployments."
      }
    },
    "countryCode": {
      "type": "string",
      "defaultValue": "US",
      "metadata": {
        "description": "Two-letter country code sent to Anthropic. Needed only for Anthropic (Claude) deployments."
      }
    },
    "models": {
      "type": "array",
      "defaultValue": [
        {
          "name": "gpt-6.1-sol",
          "format": "OpenAI",
          "version": "2026-09-29",
          "capacity": 20
        },
        {
          "name": "gpt-6-sol",
          "format": "OpenAI",
          "version": "2026-09-22",
          "capacity": 20
        },
        {
          "name": "gpt-6-luna",
          "format": "OpenAI",
          "version": "2026-09-22",
          "capacity": 20
        },
        {
          "name": "gpt-6-astra",
          "format": "OpenAI",
          "version": "2026-09-03",
          "capacity": 20
        },
        {
          "name": "Microsoft-Decision-1",
          "deploymentName": "decision-1",
          "format": "Microsoft",
          "version": "1",
          "capacity": 10,
          "endpoints": [
            "/providers/microsoft/v1/systemone"
          ]
        }
      ],
      "metadata": {
        "description": "Foundry model deployments. Fields: name, format (OpenAI, Anthropic or Microsoft), version, capacity; optional deploymentName (defaults to name), sku (defaults to GlobalStandard), endpoints (gateway paths; defaults by format) and gateway (defaults to true; false deploys in Foundry only). Claude (Anthropic) deployments need a subscription that can buy the Anthropic Marketplace offer, plus organizationName."
      }
    },
    "selectedModels": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Names (deploymentName or name) of the models entries to deploy. Empty deploys every entry in models. The portal form sets this from its model checklist."
      }
    },
    "capacityOverride": {
      "type": "int",
      "defaultValue": 0,
      "minValue": 0,
      "metadata": {
        "description": "If greater than 0, use this Global Standard capacity for every selected model instead of each entry's capacity."
      }
    },
    "aliases": {
      "type": "array",
      "defaultValue": [
        {
          "name": "gpt-latest",
          "description": "Latest GPT model with failover to gpt-6-sol.",
          "backends": [
            {
              "model": "gpt-6.1-sol",
              "priority": 0
            },
            {
              "model": "gpt-6-sol",
              "priority": 1
            }
          ]
        }
      ],
      "metadata": {
        "description": "Gateway aliases with failover. Each backend names a deployment from models. Backends whose model is not deployed are dropped, and aliases left with no backend are skipped."
      }
    },
    "payloadCapture": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Capture request and response payloads in gateway traces. Required for token usage (gen_ai.usage.*) and model attributes in traces. Stores prompt and completion text in Application Insights; turn off if policy forbids it."
      }
    },
    "monthlyBudget": {
      "type": "int",
      "defaultValue": 100,
      "minValue": 1,
      "metadata": {
        "description": "Monthly budget for this resource group, in the billing currency. Alerts fire at 80% of actual spend and 100% of forecast spend."
      }
    },
    "budgetAlertEmail": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional email address for budget alerts. Resource group owners are always notified."
      }
    },
    "budgetStartDate": {
      "type": "string",
      "defaultValue": "[utcNow('yyyy-MM-01')]",
      "metadata": {
        "description": "First day of the budget period. Defaults to the first day of the current month."
      }
    },
    "nextStepsBaseUrl": {
      "type": "string",
      "defaultValue": "https://brk-tech-sovereign-ai.azurewebsites.net/next-steps.html",
      "metadata": {
        "description": "Web page that shows next steps for this deployment. The deployment appends its values to the URL fragment."
      }
    }
  },
  "variables": {
    "copy": [
      {
        "name": "directAliases",
        "count": "[length(variables('gatewayModelList'))]",
        "input": {
          "name": "[coalesce(tryGet(variables('gatewayModelList')[copyIndex('directAliases')], 'deploymentName'), variables('gatewayModelList')[copyIndex('directAliases')].name)]",
          "description": "[format('Direct access to {0}.', variables('gatewayModelList')[copyIndex('directAliases')].name)]",
          "backends": [
            {
              "model": "[coalesce(tryGet(variables('gatewayModelList')[copyIndex('directAliases')], 'deploymentName'), variables('gatewayModelList')[copyIndex('directAliases')].name)]",
              "priority": 0
            }
          ]
        }
      }
    ],
    "chosenModels": "[if(empty(parameters('selectedModels')), parameters('models'), filter(parameters('models'), lambda('m', contains(parameters('selectedModels'), coalesce(tryGet(lambdaVariables('m'), 'deploymentName'), lambdaVariables('m').name)))))]",
    "effectiveModels": "[map(variables('chosenModels'), lambda('m', if(greater(parameters('capacityOverride'), 0), union(lambdaVariables('m'), createObject('capacity', parameters('capacityOverride'))), lambdaVariables('m'))))]",
    "token": "[take(toLower(uniqueString(resourceGroup().id, parameters('namePrefix'))), 6)]",
    "base": "[format('{0}-{1}', toLower(parameters('namePrefix')), variables('token'))]",
    "gatewayName": "[format('aigw-{0}', variables('base'))]",
    "modelAccountName": "[format('aimodels-{0}', variables('base'))]",
    "tags": {
      "sovereign-ai-variant": "provider-models-public-cloud"
    },
    "workspaceName": "default",
    "foundryProviderName": "foundry",
    "endpointsByFormat": {
      "OpenAI": [
        "/openai/v1/chat/completions",
        "/openai/v1/responses"
      ],
      "Anthropic": [
        "/anthropic/v1/messages"
      ]
    },
    "gatewayModelList": "[filter(variables('effectiveModels'), lambda('m', coalesce(tryGet(lambdaVariables('m'), 'gateway'), true())))]",
    "gatewayModelNames": "[map(variables('gatewayModelList'), lambda('m', coalesce(tryGet(lambdaVariables('m'), 'deploymentName'), lambdaVariables('m').name)))]",
    "availableAliases": "[filter(map(parameters('aliases'), lambda('a', createObject('name', lambdaVariables('a').name, 'description', lambdaVariables('a').description, 'backends', filter(lambdaVariables('a').backends, lambda('b', contains(variables('gatewayModelNames'), lambdaVariables('b').model)))))), lambda('a', greater(length(lambdaVariables('a').backends), 0)))]",
    "allAliases": "[concat(variables('directAliases'), variables('availableAliases'))]",
    "apiFormatByFormat": {
      "OpenAI": "OpenAIChatCompletions",
      "Anthropic": "AnthropicMessages"
    },
    "foundryUserRole": "53ca6127-db72-4b80-b1b0-d745d6d5456d",
    "cognitiveServicesUserRole": "a97b65f3-24c7-4388-baec-2e87135dc908",
    "aiGatewayUserRole": "caad7a21-134e-43f4-a550-c5ffc17e051c",
    "deployerId": "[deployer().objectId]",
    "grantExtraPrincipal": "[and(not(empty(parameters('principalId'))), not(equals(parameters('principalId'), variables('deployerId'))))]",
    "budgetContactEmails": "[if(empty(parameters('budgetAlertEmail')), createArray(), createArray(parameters('budgetAlertEmail')))]",
    "tokenAudience": "https://azure-api.net/aigateway",
    "aliasNames": "[map(variables('allAliases'), lambda('a', lambdaVariables('a').name))]",
    "firstModel": "[if(or(contains(variables('aliasNames'), 'gpt-latest'), empty(variables('aliasNames'))), 'gpt-latest', variables('aliasNames')[0])]",
    "portalBase": "[format('https://portal.azure.com/#@{0}', tenant().tenantId)]",
    "dashboardName": "[format('start-{0}', variables('base'))]",
    "dashboardUrl": "[format('{0}/dashboard/arm{1}/providers/Microsoft.Portal/dashboards/{2}', variables('portalBase'), resourceGroup().id, variables('dashboardName'))]",
    "foundryOnlyNames": "[map(filter(variables('effectiveModels'), lambda('m', not(coalesce(tryGet(lambdaVariables('m'), 'gateway'), true())))), lambda('m', coalesce(tryGet(lambdaVariables('m'), 'deploymentName'), lambdaVariables('m').name)))]",
    "decisionGatewayNames": "[map(filter(variables('gatewayModelList'), lambda('m', contains(coalesce(tryGet(lambdaVariables('m'), 'endpoints'), createArray()), '/providers/microsoft/v1/systemone'))), lambda('m', coalesce(tryGet(lambdaVariables('m'), 'deploymentName'), lambdaVariables('m').name)))]",
    "chatAliasNames": "[filter(variables('aliasNames'), lambda('a', not(contains(variables('decisionGatewayNames'), lambdaVariables('a')))))]"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[format('{0}-logs', variables('gatewayName'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "retentionInDays": 30,
        "sku": {
          "name": "PerGB2018"
        },
        "features": {
          "enableLogAccessUsingOnlyResourcePermissions": true
        }
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[format('{0}-insights', variables('gatewayName'))]",
      "location": "[parameters('location')]",
      "kind": "web",
      "tags": "[variables('tags')]",
      "properties": {
        "Application_Type": "web",
        "IngestionMode": "LogAnalytics",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', variables('gatewayName')))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', variables('gatewayName')))]"
      ]
    },
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2026-09-01",
      "name": "[variables('modelAccountName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "kind": "AIServices",
      "sku": {
        "name": "S0"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "allowProjectManagement": false,
        "customSubDomainName": "[variables('modelAccountName')]",
        "disableLocalAuth": true,
        "publicNetworkAccess": "Enabled",
        "networkAcls": {
          "defaultAction": "Allow"
        }
      }
    },
    {
      "copy": {
        "name": "deployments",
        "count": "[length(variables('effectiveModels'))]",
        "mode": "serial",
        "batchSize": 1
      },
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2026-09-01",
      "name": "[format('{0}/{1}', variables('modelAccountName'), coalesce(tryGet(variables('effectiveModels')[copyIndex()], 'deploymentName'), variables('effectiveModels')[copyIndex()].name))]",
      "sku": {
        "name": "[coalesce(tryGet(variables('effectiveModels')[copyIndex()], 'sku'), 'GlobalStandard')]",
        "capacity": "[variables('effectiveModels')[copyIndex()].capacity]"
      },
      "properties": "[union(createObject('model', createObject('format', variables('effectiveModels')[copyIndex()].format, 'name', variables('effectiveModels')[copyIndex()].name, 'version', variables('effectiveModels')[copyIndex()].version)), if(equals(variables('effectiveModels')[copyIndex()].format, 'Anthropic'), createObject('modelProviderData', createObject('organizationName', parameters('organizationName'), 'industry', parameters('industry'), 'countryCode', parameters('countryCode'))), createObject()))]",
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('modelAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.CognitiveServices/accounts', variables('modelAccountName'))]",
      "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts', variables('modelAccountName')), variables('cognitiveServicesUserRole'), variables('deployerId'))]",
      "properties": {
        "principalId": "[variables('deployerId')]",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('cognitiveServicesUserRole'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('modelAccountName'))]"
      ]
    },
    {
      "condition": "[variables('grantExtraPrincipal')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.CognitiveServices/accounts', variables('modelAccountName'))]",
      "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts', variables('modelAccountName')), variables('cognitiveServicesUserRole'), parameters('principalId'))]",
      "properties": {
        "principalId": "[parameters('principalId')]",
        "principalType": "[parameters('principalType')]",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('cognitiveServicesUserRole'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('modelAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.ApiManagement/aigateways",
      "apiVersion": "2025-09-01-preview",
      "name": "[variables('gatewayName')]",
      "location": "[parameters('aiGatewayLocation')]",
      "tags": "[variables('tags')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "sku": {
        "name": "Premium"
      },
      "properties": {}
    },
    {
      "type": "Microsoft.Web/connectorGateways",
      "apiVersion": "2026-05-01-preview",
      "name": "[variables('gatewayName')]",
      "location": "[parameters('aiGatewayLocation')]",
      "tags": "[variables('tags')]",
      "properties": {},
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/aigateways', variables('gatewayName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.CognitiveServices/accounts', variables('modelAccountName'))]",
      "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts', variables('modelAccountName')), resourceId('Microsoft.ApiManagement/aigateways', variables('gatewayName')), variables('foundryUserRole'))]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.ApiManagement/aigateways', variables('gatewayName')), '2025-09-01-preview', 'full').identity.principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('foundryUserRole'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/aigateways', variables('gatewayName'))]",
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('modelAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.ApiManagement/aigateways/workspaces/telemetryExporters",
      "apiVersion": "2025-09-01-preview",
      "name": "[format('{0}/{1}/{2}', variables('gatewayName'), variables('workspaceName'), 'appinsights')]",
      "properties": {
        "kind": "applicationInsights",
        "payloadCapture": "[parameters('payloadCapture')]",
        "applicationInsights": {
          "connectionString": "[reference(resourceId('Microsoft.Insights/components', format('{0}-insights', variables('gatewayName'))), '2020-02-02').ConnectionString]",
          "resourceId": "[resourceId('Microsoft.Insights/components', format('{0}-insights', variables('gatewayName')))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/aigateways', variables('gatewayName'))]",
        "[resourceId('Microsoft.Insights/components', format('{0}-insights', variables('gatewayName')))]"
      ]
    },
    {
      "type": "Microsoft.ApiManagement/aigateways/workspaces/modelProviders",
      "apiVersion": "2025-09-01-preview",
      "name": "[format('{0}/{1}/{2}', variables('gatewayName'), variables('workspaceName'), variables('foundryProviderName'))]",
      "properties": {
        "kind": "Foundry",
        "displayName": "Foundry",
        "description": "[format('Foundry model account {0}, reached with the gateway managed identity.', variables('modelAccountName'))]",
        "foundry": {
          "endpoint": "[reference(resourceId('Microsoft.CognitiveServices/accounts', variables('modelAccountName')), '2026-09-01').endpoint]",
          "resourceIds": [
            "[resourceId('Microsoft.CognitiveServices/accounts', variables('modelAccountName'))]"
          ],
          "authentication": {
            "kind": "ManagedIdentity",
            "managedIdentity": {
              "resource": "https://cognitiveservices.azure.com/"
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/aigateways', variables('gatewayName'))]",
        "[extensionResourceId(resourceId('Microsoft.CognitiveServices/accounts', variables('modelAccountName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.CognitiveServices/accounts', variables('modelAccountName')), resourceId('Microsoft.ApiManagement/aigateways', variables('gatewayName')), variables('foundryUserRole')))]",
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('modelAccountName'))]"
      ]
    },
    {
      "copy": {
        "name": "gatewayModels",
        "count": "[length(variables('effectiveModels'))]"
      },
      "condition": "[coalesce(tryGet(variables('effectiveModels')[copyIndex()], 'gateway'), true())]",
      "type": "Microsoft.ApiManagement/aigateways/workspaces/modelProviders/models",
      "apiVersion": "2025-09-01-preview",
      "name": "[format('{0}/{1}/{2}/{3}', variables('gatewayName'), variables('workspaceName'), variables('foundryProviderName'), coalesce(tryGet(variables('effectiveModels')[copyIndex()], 'deploymentName'), variables('effectiveModels')[copyIndex()].name))]",
      "properties": {
        "displayName": "[variables('effectiveModels')[copyIndex()].name]",
        "description": "[format('{0} model {1} ({2}) on {3}.', variables('effectiveModels')[copyIndex()].format, variables('effectiveModels')[copyIndex()].name, variables('effectiveModels')[copyIndex()].version, variables('modelAccountName'))]",
        "apiFormat": "[tryGet(variables('apiFormatByFormat'), variables('effectiveModels')[copyIndex()].format)]",
        "supportedEndpoints": "[coalesce(coalesce(tryGet(variables('effectiveModels')[copyIndex()], 'endpoints'), tryGet(variables('endpointsByFormat'), variables('effectiveModels')[copyIndex()].format)), variables('endpointsByFormat').OpenAI)]",
        "deployment": {
          "resourceId": "[resourceId('Microsoft.CognitiveServices/accounts/deployments', variables('modelAccountName'), coalesce(tryGet(variables('effectiveModels')[copyIndex()], 'deploymentName'), variables('effectiveModels')[copyIndex()].name))]",
          "modelName": "[coalesce(tryGet(variables('effectiveModels')[copyIndex()], 'deploymentName'), variables('effectiveModels')[copyIndex()].name)]",
          "modelVersion": "[variables('effectiveModels')[copyIndex()].version]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts/deployments', variables('modelAccountName'), coalesce(tryGet(variables('effectiveModels')[copyIndex()], 'deploymentName'), variables('effectiveModels')[copyIndex()].name))]",
        "[resourceId('Microsoft.ApiManagement/aigateways/workspaces/modelProviders', variables('gatewayName'), variables('workspaceName'), variables('foundryProviderName'))]"
      ]
    },
    {
      "copy": {
        "name": "gatewayAliases",
        "count": "[length(variables('allAliases'))]"
      },
      "type": "Microsoft.ApiManagement/aigateways/workspaces/aliases",
      "apiVersion": "2025-09-01-preview",
      "name": "[format('{0}/{1}/{2}', variables('gatewayName'), variables('workspaceName'), variables('allAliases')[copyIndex()].name)]",
      "properties": {
        "copy": [
          {
            "name": "backendModels",
            "count": "[length(variables('allAliases')[copyIndex()].backends)]",
            "input": {
              "resourceId": "[resourceId('Microsoft.ApiManagement/aigateways/workspaces/modelProviders/models', variables('gatewayName'), variables('workspaceName'), variables('foundryProviderName'), variables('allAliases')[copyIndex()].backends[copyIndex('backendModels')].model)]",
              "priority": "[variables('allAliases')[copyIndex()].backends[copyIndex('backendModels')].priority]",
              "weight": 100
            }
          }
        ],
        "aliasName": "[variables('allAliases')[copyIndex()].name]",
        "description": "[variables('allAliases')[copyIndex()].description]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/aigateways', variables('gatewayName'))]",
        "gatewayModels"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.ApiManagement/aigateways', variables('gatewayName'))]",
      "name": "[guid(resourceId('Microsoft.ApiManagement/aigateways', variables('gatewayName')), variables('aiGatewayUserRole'), variables('deployerId'))]",
      "properties": {
        "principalId": "[variables('deployerId')]",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('aiGatewayUserRole'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/aigateways', variables('gatewayName'))]"
      ]
    },
    {
      "condition": "[variables('grantExtraPrincipal')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.ApiManagement/aigateways', variables('gatewayName'))]",
      "name": "[guid(resourceId('Microsoft.ApiManagement/aigateways', variables('gatewayName')), variables('aiGatewayUserRole'), parameters('principalId'))]",
      "properties": {
        "principalId": "[parameters('principalId')]",
        "principalType": "[parameters('principalType')]",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('aiGatewayUserRole'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/aigateways', variables('gatewayName'))]"
      ]
    },
    {
      "type": "Microsoft.Consumption/budgets",
      "apiVersion": "2023-11-01",
      "name": "[format('budget-{0}', variables('base'))]",
      "properties": {
        "category": "Cost",
        "amount": "[parameters('monthlyBudget')]",
        "timeGrain": "Monthly",
        "timePeriod": {
          "startDate": "[parameters('budgetStartDate')]"
        },
        "notifications": {
          "actual80": {
            "enabled": true,
            "operator": "GreaterThanOrEqualTo",
            "threshold": 80,
            "thresholdType": "Actual",
            "contactRoles": [
              "Owner"
            ],
            "contactEmails": "[variables('budgetContactEmails')]"
          },
          "forecast100": {
            "enabled": true,
            "operator": "GreaterThanOrEqualTo",
            "threshold": 100,
            "thresholdType": "Forecasted",
            "contactRoles": [
              "Owner"
            ],
            "contactEmails": "[variables('budgetContactEmails')]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Portal/dashboards",
      "apiVersion": "2020-09-01-preview",
      "name": "[variables('dashboardName')]",
      "location": "[parameters('location')]",
      "tags": "[union(variables('tags'), createObject('hidden-title', format('Start here: {0}', variables('gatewayName'))))]",
      "properties": {
        "lenses": [
          {
            "order": 0,
            "parts": [
              {
                "position": {
                  "x": 0,
                  "y": 0,
                  "colSpan": 8,
                  "rowSpan": 9
                },
                "metadata": {
                  "inputs": [],
                  "type": "Extension/HubsExtension/PartType/MarkdownPart",
                  "settings": {
