{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "11466148456737616053"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "eastus2",
      "allowedValues": [
        "eastus2",
        "swedencentral"
      ],
      "metadata": {
        "description": "Region for Foundry, storage, container registry and monitoring. Claude models need a region that offers them."
      }
    },
    "aiGatewayLocation": {
      "type": "string",
      "defaultValue": "eastus2",
      "allowedValues": [
        "eastus2",
        "swedencentral"
      ],
      "metadata": {
        "description": "Region for the AI Gateway (preview regions only)."
      }
    },
    "namePrefix": {
      "type": "string",
      "defaultValue": "sovai",
      "minLength": 3,
      "maxLength": 8,
      "metadata": {
        "description": "Short lowercase prefix for resource names."
      }
    },
    "principalId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional Entra object ID of a user, group or service principal. It gets the AI Gateway User role (call models and tools) and Foundry developer access. Leave empty to skip."
      }
    },
    "principalType": {
      "type": "string",
      "defaultValue": "User",
      "allowedValues": [
        "User",
        "Group",
        "ServicePrincipal"
      ],
      "metadata": {
        "description": "Type of principalId."
      }
    },
    "createApiKey": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Create a gateway API key. Microsoft recommends Entra ID and Azure RBAC instead of keys for production callers."
      }
    },
    "organizationName": {
      "type": "string",
      "metadata": {
        "description": "Organization name sent to Anthropic for Claude deployments (required by Foundry)."
      }
    },
    "industry": {
      "type": "string",
      "defaultValue": "Financial Services",
      "metadata": {
        "description": "Industry sent to Anthropic for Claude deployments (required by Foundry)."
      }
    },
    "countryCode": {
      "type": "string",
      "defaultValue": "US",
      "metadata": {
        "description": "Two-letter country code sent to Anthropic for Claude deployments (required by Foundry)."
      }
    },
    "models": {
      "type": "array",
      "defaultValue": [
        {
          "name": "gpt-6.1-sol",
          "format": "OpenAI",
          "version": "2026-09-29",
          "capacity": 20
        },
        {
          "name": "gpt-6-sol",
          "format": "OpenAI",
          "version": "2026-09-22",
          "capacity": 20
        },
        {
          "name": "gpt-6-luna",
          "format": "OpenAI",
          "version": "2026-09-22",
          "capacity": 20
        },
        {
          "name": "gpt-6-astra",
          "format": "OpenAI",
          "version": "2026-09-03",
          "capacity": 20
        },
        {
          "name": "claude-opus-5-5",
          "format": "Anthropic",
          "version": "2",
          "capacity": 10
        },
        {
          "name": "claude-sonnet-5-5",
          "format": "Anthropic",
          "version": "2",
          "capacity": 20
        },
        {
          "name": "claude-haiku-5-5",
          "format": "Anthropic",
          "version": "2",
          "capacity": 20
        }
      ],
      "metadata": {
        "description": "Foundry model deployments. format is OpenAI or Anthropic; capacity is the Global Standard capacity."
      }
    },
    "aliases": {
      "type": "array",
      "defaultValue": [
        {
          "name": "gpt-latest",
          "description": "Latest GPT model with failover to gpt-6-sol.",
          "backends": [
            {
              "model": "gpt-6.1-sol",
              "priority": 0
            },
            {
              "model": "gpt-6-sol",
              "priority": 1
            }
          ]
        },
        {
          "name": "claude-latest",
          "description": "Latest Claude model with failover to Sonnet.",
          "backends": [
            {
              "model": "claude-opus-5-5",
              "priority": 0
            },
            {
              "model": "claude-sonnet-5-5",
              "priority": 1
            }
          ]
        }
      ],
      "metadata": {
        "description": "Gateway aliases with failover. Each backend names a deployment from models."
      }
    },
    "deployAgentResources": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Deploy the Foundry project, storage and container registry for hosted agents."
      }
    },
    "containerRegistrySku": {
      "type": "string",
      "defaultValue": "Basic",
      "allowedValues": [
        "Basic",
        "Standard",
        "Premium"
      ],
      "metadata": {
        "description": "Container registry SKU for hosted-agent images."
      }
    },
    "payloadCapture": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Capture prompt and completion payloads in gateway telemetry. Keep off unless policy permits it."
      }
    }
  },
  "variables": {
    "copy": [
      {
        "name": "directAliases",
        "count": "[length(parameters('models'))]",
        "input": {
          "name": "[parameters('models')[copyIndex('directAliases')].name]",
          "description": "[format('Direct access to {0}.', parameters('models')[copyIndex('directAliases')].name)]",
          "backends": [
            {
              "model": "[parameters('models')[copyIndex('directAliases')].name]",
              "priority": 0
            }
          ]
        }
      }
    ],
    "token": "[take(toLower(uniqueString(resourceGroup().id, parameters('namePrefix'))), 6)]",
    "base": "[format('{0}-{1}', toLower(parameters('namePrefix')), variables('token'))]",
    "gatewayName": "[format('aigw-{0}', variables('base'))]",
    "modelAccountName": "[format('aimodels-{0}', variables('base'))]",
    "agentAccountName": "[format('aiagents-{0}', variables('base'))]",
    "projectName": "[format('proj-{0}', variables('base'))]",
    "storageName": "[take(format('st{0}{1}', toLower(parameters('namePrefix')), variables('token')), 24)]",
    "registryName": "[take(format('acr{0}{1}', toLower(parameters('namePrefix')), variables('token')), 50)]",
    "tags": {
      "sovereign-ai-variant": "provider-models-public-cloud"
    },
    "workspaceName": "default",
    "foundryProviderName": "foundry",
    "endpointsByFormat": {
