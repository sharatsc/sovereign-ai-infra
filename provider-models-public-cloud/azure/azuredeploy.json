      "properties": {
        "displayName": "[parameters('models')[copyIndex()].name]",
        "description": "[format('{0} model {1} ({2}) on {3}.', parameters('models')[copyIndex()].format, parameters('models')[copyIndex()].name, parameters('models')[copyIndex()].version, variables('modelAccountName'))]",
        "apiFormat": "[variables('apiFormatByFormat')[parameters('models')[copyIndex()].format]]",
        "supportedEndpoints": "[variables('endpointsByFormat')[parameters('models')[copyIndex()].format]]",
        "deployment": {
          "resourceId": "[resourceId('Microsoft.CognitiveServices/accounts/deployments', variables('modelAccountName'), parameters('models')[copyIndex()].name)]",
          "modelName": "[parameters('models')[copyIndex()].name]",
          "modelVersion": "[parameters('models')[copyIndex()].version]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts/deployments', variables('modelAccountName'), parameters('models')[copyIndex()].name)]",
        "[resourceId('Microsoft.ApiManagement/aigateways/workspaces/modelProviders', variables('gatewayName'), variables('workspaceName'), variables('foundryProviderName'))]"
      ]
    },
    {
      "copy": {
