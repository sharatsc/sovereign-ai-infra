        "principalId": "[parameters('principalId')]",
        "principalType": "[parameters('principalType')]",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('aiGatewayUserRole'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/aigateways', variables('gatewayName'))]"
      ]
    }
  ],
  "outputs": {
    "chatCompletionsUrl": {
      "type": "string",
      "value": "[format('{0}default/models/openai/v1/chat/completions', format('https://{0}/', coalesce(tryGet(tryGet(reference(resourceId('Microsoft.ApiManagement/aigateways', variables('gatewayName')), '2025-09-01-preview'), 'frontend'), 'defaultHostname'), '')))]"
    },
    "gatewayModelNames": {
      "type": "array",
      "value": [
        "[variables('deploymentName')]"
      ]
    },
    "tokenAudience": {
      "type": "string",
      "value": "[variables('tokenAudience')]"
    },
    "tryIt": {
      "type": "string",
      "value": "[format('TOKEN=$(az account get-access-token --resource {0} --query accessToken -o tsv); curl -s {1} -H \"Authorization: Bearer $TOKEN\" -H \"Content-Type: application/json\" -d ''{{\"model\":\"{2}\",\"messages\":[{{\"role\":\"user\",\"content\":\"Hello\"}}]}}''', variables('tokenAudience'), format('{0}default/models/openai/v1/chat/completions', format('https://{0}/', coalesce(tryGet(tryGet(reference(resourceId('Microsoft.ApiManagement/aigateways', variables('gatewayName')), '2025-09-01-preview'), 'frontend'), 'defaultHostname'), ''))), variables('deploymentName'))]"
    },
    "estimatedHourlyCost": {
      "type": "string",
      "metadata": {
        "description": "Estimated cost in USD for every hour the deployment runs, at Global managed compute rates."
      },
      "value": "[variables('estimatedHourlyCost')]"
    },
    "estimatedMonthlyCost": {
      "type": "int",
      "metadata": {
        "description": "Estimated cost in USD for a month (730 hours) of running."
      },
      "value": "[variables('estimatedMonthlyCost')]"
    },
    "monthlyBudget": {
      "type": "int",
      "value": "[variables('effectiveBudget')]"
    },
    "model": {
      "type": "string",
      "value": "[variables('selected').model]"
    },
    "deploymentTemplate": {
      "type": "string",
      "value": "[variables('option').template]"
    },
    "license": {
      "type": "string",
      "value": "[variables('selected').license]"
    },
    "huggingFaceModel": {
      "type": "string",
      "value": "[variables('selected').huggingFace]"
    },
    "deploymentScope": {
      "type": "string",
      "value": "Global"
    },
    "foundryEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', variables('modelAccountName')), '2026-11-01').endpoint]"
    },
    "aiGatewayName": {
      "type": "string",
      "value": "[variables('gatewayName')]"
    },
    "aiGatewayId": {
      "type": "string",
      "value": "[resourceId('Microsoft.ApiManagement/aigateways', variables('gatewayName'))]"
    },
    "aiGatewayEndpoint": {
      "type": "string",
      "value": "[format('https://{0}/', coalesce(tryGet(tryGet(reference(resourceId('Microsoft.ApiManagement/aigateways', variables('gatewayName')), '2025-09-01-preview'), 'frontend'), 'defaultHostname'), ''))]"
    },
    "grantAccessCommand": {
      "type": "string",
      "value": "[format('az role assignment create --role \"AI Gateway User\" --assignee <object-id> --scope {0}', resourceId('Microsoft.ApiManagement/aigateways', variables('gatewayName')))]"
    }
  }
}