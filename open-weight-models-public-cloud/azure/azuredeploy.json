      "maxLength": 8,
      "metadata": {
        "description": "Short lowercase prefix for resource names."
      }
    },
    "modelKey": {
      "type": "string",
      "defaultValue": "gpt-oss-20b",
      "allowedValues": [
        "gpt-oss-20b",
        "nemotron-35-lightning-30b",
        "muse-glimmer-30b",
        "gemma-4-31b"
