    "catalog": "[variables('$fxv#0')]",
    "selected": "[variables('catalog').models[parameters('modelKey')]]",
    "option": "[variables('selected').options[if(empty(parameters('optionKey')), variables('selected').defaultOption, parameters('optionKey'))]]",
    "hourlyCents": "[mul(mul(variables('catalog').rateCentsPerAcceleratorHour[variables('option').accelerator], variables('option').count), parameters('instances'))]",
    "estimatedHourlyCost": "[format('{0}.{1}', div(variables('hourlyCents'), 100), padLeft(string(mod(variables('hourlyCents'), 100)), 2, '0'))]",
    "estimatedMonthlyCost": "[div(add(mul(variables('hourlyCents'), variables('catalog').hoursPerMonth), 99), 100)]",
    "effectiveBudget": "[if(greater(parameters('monthlyBudget'), 0), parameters('monthlyBudget'), mul(div(add(div(mul(variables('estimatedMonthlyCost'), 110), 100), 99), 100), 100))]",
    "token": "[take(toLower(uniqueString(resourceGroup().id, parameters('namePrefix'))), 6)]",
    "base": "[format('{0}-{1}', toLower(parameters('namePrefix')), variables('token'))]",
    "gatewayName": "[format('aigw-{0}', variables('base'))]",
    "modelAccountName": "[format('aimodels-{0}', variables('base'))]",
    "tags": {
      "sovereign-ai-variant": "open-weight-models-public-cloud"
    },
    "workspaceName": "default",
    "foundryProviderName": "foundry",
    "deploymentName": "[variables('selected').deploymentName]",
    "modelVersion": "[last(split(variables('selected').model, '/'))]",
    "foundryUserRole": "53ca6127-db72-4b80-b1b0-d745d6d5456d",
    "aiGatewayUserRole": "caad7a21-134e-43f4-a550-c5ffc17e051c",
    "deployerId": "[deployer().objectId]",
    "grantExtraPrincipal": "[and(not(empty(parameters('principalId'))), not(equals(parameters('principalId'), variables('deployerId'))))]",
    "tokenAudience": "https://azure-api.net/aigateway"
  },
